APP_NAME="Aapka PG Management System"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./pg_management.db
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEV_OTP_MODE=true
DEV_OTP_CODE=
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_RATE_LIMIT_MAX_REQUESTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_WEBHOOK_URL=
UPLOAD_DIR=uploads
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Razorpay Test Mode Credentials (leave blank when online checkout is disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Meal skip cutoff times (HH:MM 24h)
MEAL_SKIP_ENFORCE_CUTOFF=true
MEAL_SKIP_CUTOFF_BREAKFAST=07:00
MEAL_SKIP_CUTOFF_LUNCH=10:30
MEAL_SKIP_CUTOFF_DINNER=17:30


